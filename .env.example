# Copy to .env for local use. Process environment variables take precedence.
ROOMWISE_DATA_DIR=var
# Required before remote access. Single-user service token, not multi-user authorization.
ROOMWISE_API_TOKEN=
ROOMWISE_CORS_ORIGINS=
# Owner switch: leave off until a model runtime is deliberately configured.
ROOMWISE_EXTERNAL_ENABLED=false
# google for hosted Gemma/Gemini; openai_compatible for a local/custom Gemma server.
ROOMWISE_AI_PROVIDER=disabled
ROOMWISE_AI_MODEL=
# Server-side secret only. Never paste a provider key into the browser access-token form.
ROOMWISE_AI_API_KEY=
ROOMWISE_AI_BASE_URL=http://127.0.0.1:11434/v1
# Persistent attempt cap; failures count, automatic retries are disabled.
ROOMWISE_AI_DAILY_REQUESTS=30
# Google Maps credentials; blank examples only, never commit actual credentials.
ROOMWISE_MAPS_JAVASCRIPT_API_KEY=
ROOMWISE_PLACES_API_KEY=
ROOMWISE_ROUTES_API_KEY=
# Browser Maps loads incur provider usage outside the server web-service cap.
ROOMWISE_MAPS_ENABLED=false
ROOMWISE_PLACES_ENABLED=false
ROOMWISE_ROUTES_ENABLED=false
# Shared daily Places + Routes attempt limit; failed attempts count.
ROOMWISE_MAPS_DAILY_REQUESTS=60
# Optional local username/password accounts. Default stays single operator.
ROOMWISE_ACCOUNTS_REQUIRED=false
# Explicit private development convenience: loopback client + localhost URL only.
# LAN clients still require ROOMWISE_API_TOKEN. Leave disabled for a hosted service.
ROOMWISE_LOCAL_OPERATOR_ENABLED=false
